[Desktop Entry]
Type=Application
Name=Kladde
Comment=PDF-Betrachter
# @KLADDE@ is replaced by the absolute path to the binary by packaging/install.sh
Exec=@KLADDE@ --fullscreen %f
Icon=kladde
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;
Keywords=pdf;viewer;document;reader;blatt;zettel
StartupNotify=false
