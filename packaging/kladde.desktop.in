[Desktop Entry]
Type=Application
Name=Kladde
Comment=PDF-Betrachter
# @KLADDE@ wird von packaging/install-user.sh durch den absoluten Pfad ersetzt.
Exec=@KLADDE@ --fullscreen %f
Icon=kladde
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;
Keywords=pdf;viewer;document;reader;blatt;zettel
StartupNotify=false
